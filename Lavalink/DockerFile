FROM openjdk:17-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY application.yml .

# Download Lavalink v3.7.13 jar explicitly from GitHub releases
RUN wget https://github.com/lavalink-devs/lavalink/releases/download/3.7.13/Lavalink.jar

EXPOSE 2333

CMD ["java", "-jar", "Lavalink.jar"]
